      function loadGLTFArrayBuffer(buffer) {
        if (typeof THREE.GLTFLoader === 'undefined') {
          console.warn('GLTFLoader is not available.');
          return;
        }
        const loader = new THREE.GLTFLoader();
        loader.parse(buffer, '', (gltf) => {
          const loadedModel = gltf.scene;
          normalizeAndCenterModel(loadedModel);
          
          relicModels[0] = loadedModel;
          if (currentRelicIdx === 0) {
            clearGroup(relicContainer);
            relicContainer.add(loadedModel);
