      // Draw Skeleton on Skeleton Overlay Canvas
      function drawSkeleton(landmarks) {
        const w = skeletonCanvas.width;
        const h = skeletonCanvas.height;

        const connections = [
          [0,1],[1,2],[2,3],[3,4],
          [0,5],[5,6],[6,7],[7,8],
          [5,9],[9,10],[10,11],[11,12],
          [9,13],[13,14],[14,15],[15,16],
          [13,17],[17,18],[18,19],[19,20],[0,17]
        ];

        skeletonCtx.strokeStyle = 'rgba(251, 191, 36, 0.65)';
        skeletonCtx.lineWidth = 2;

        connections.forEach(([i, j]) => {
          const p1 = landmarks[i];
          const p2 = landmarks[j];
          skeletonCtx.beginPath();
          skeletonCtx.moveTo(p1.x * w, p1.y * h);
          skeletonCtx.lineTo(p2.x * w, p2.y * h);
          skeletonCtx.stroke();
        });

        landmarks.forEach((p, idx) => {
          skeletonCtx.fillStyle = (idx === 8 || idx === 4) ? '#00ffff' : '#fbbf24';
          skeletonCtx.beginPath();
          skeletonCtx.arc(p.x * w, p.y * h, (idx === 8 || idx === 4) ? 5 : 3, 0, Math.PI * 2);
          skeletonCtx.fill();
        });
      }

      function onHandResults(results) {
        skeletonCtx.clearRect(0, 0, skeletonCanvas.width, skeletonCanvas.height);

        const handStatusDot = document.getElementById('handStatusDot');
        const statusText = document.getElementById('handStatusText');

        if (!results.multiHandLandmarks || results.multiHandLandmarks.length === 0) {
          handStatusDot.className = 'w-2.5 h-2.5 rounded-full bg-amber-500';
          if (statusText) statusText.innerText = '未检测到手势 | 鼠标/触摸可拖拽';
          prevHandPos = null;
          prevPinchDistTwoHands = null;
          return;
        }

        handStatusDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse';

        results.multiHandLandmarks.forEach(landmarks => drawSkeleton(landmarks));

        const handCount = results.multiHandLandmarks.length;

        // Single Hand -> Rotation Control
        if (handCount === 1) {
          const landmarks = results.multiHandLandmarks[0];
          const indexTip = landmarks[8];
          const thumbTip = landmarks[4];

          if (statusText) statusText.innerText = '单手控制: 移动旋转视角';

          if (prevHandPos) {
            const dx = (indexTip.x - prevHandPos.x) * 5;
            const dy = (indexTip.y - prevHandPos.y) * 5;

            relicContainer.rotation.y += dx;
            relicContainer.rotation.x += dy;
          }
          prevHandPos = { x: indexTip.x, y: indexTip.y };
          prevPinchDistTwoHands = null;

          // Double Pinch Switch
          const pinchDist = Math.hypot(indexTip.x - thumbTip.x, indexTip.y - thumbTip.y);
          if (pinchDist < 0.05) {
            const now = Date.now();
            if (now - lastPinchTime > 100 && now - lastPinchTime < 500) {
              pinchCount++;
              if (pinchCount >= 2) {
                const nextIdx = (currentRelicIdx + 1) % RELIC_DATA.length;
                switchRelic(nextIdx);
                if (statusText) statusText.innerText = '👌👌 双捏合成功！切换文物';
                pinchCount = 0;
              }
            } else if (now - lastPinchTime >= 500) {
              pinchCount = 1;
            }
            lastPinchTime = now;
          }
        }
        // Two Hands -> Zoom Scale Control
        else if (handCount >= 2) {
          const hand1Index = results.multiHandLandmarks[0][8];
          const hand2Index = results.multiHandLandmarks[1][8];

          const twoHandDist = Math.hypot(hand1Index.x - hand2Index.x, hand1Index.y - hand2Index.y);

          if (prevPinchDistTwoHands !== null) {
            const scaleDelta = (twoHandDist - prevPinchDistTwoHands) * 2.5;
            let newScale = relicContainer.scale.x + scaleDelta;
            newScale = Math.max(0.4, Math.min(2.3, newScale));
            relicContainer.scale.set(newScale, newScale, newScale);

            if (statusText) statusText.innerText = `双手缩放: ${(newScale).toFixed(1)}x`;
          }
          prevPinchDistTwoHands = twoHandDist;
          prevHandPos = null;
        }
      }

      // Initialize MediaPipe Hands & Camera
      async function initCameraAndMediaPipe() {
        if (typeof Hands === 'undefined') {
          document.getElementById('handStatusText').innerText = 'MediaPipe未加载，开启触摸模式';
          return;
        }

        if (!handsDetector) {
          handsDetector = new Hands({
            locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/${file}`
          });

          handsDetector.setOptions({
            maxNumHands: 2,
            modelComplexity: 1,
            minDetectionConfidence: 0.6,
            minTrackingConfidence: 0.6
          });

          handsDetector.onResults(onHandResults);
        }

        try {
          const stream = await navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720 } });
          videoElement.srcObject = stream;
          videoElement.classList.remove('hidden');

          await new Promise((resolve) => {
            if (videoElement.readyState >= 2 && videoElement.videoWidth > 0) {
              resolve();
            } else {
              videoElement.onloadedmetadata = () => {
                videoElement.play().then(resolve).catch(resolve);
              };
            }
          });

          if (!cameraUtils) {
            cameraUtils = new Camera(videoElement, {
              onFrame: async () => {
                if (isProcessingFrame) return;
                if (!videoElement || videoElement.paused || videoElement.ended || videoElement.readyState < 2 || !videoElement.videoWidth) {
                  return;
                }

                isProcessingFrame = true;
                try {
                  await handsDetector.send({ image: videoElement });
                } catch (err) {
                  console.warn('MediaPipe frame processing warning:', err);
                } finally {
                  isProcessingFrame = false;
                }
              },
              width: 1280,
              height: 720
            });
          }

          cameraUtils.start();
          isWebcamActive = true;
          document.getElementById('handStatusDot').className = 'w-2.5 h-2.5 rounded-full bg-emerald-400';
          document.getElementById('handStatusText').innerText = '手势检测就绪';
          document.getElementById('camBtnText').innerText = '关闭摄像头';
        } catch (err) {
          console.warn('Webcam permission denied or error:', err);
          document.getElementById('handStatusText').innerText = '未获取摄像头，使用鼠标/触摸拖拽';
        }
      }

      document.getElementById('camToggleBtn').addEventListener('click', () => {
        if (!isWebcamActive) {
          initCameraAndMediaPipe();
        } else {
          if (cameraUtils) {
            try { cameraUtils.stop(); } catch (e) {}
          }
          if (videoElement.srcObject) {
            videoElement.srcObject.getTracks().forEach(track => track.stop());
            videoElement.srcObject = null;
          }
          videoElement.classList.add('hidden');
          isWebcamActive = false;
          isProcessingFrame = false;
          document.getElementById('handStatusDot').className = 'w-2.5 h-2.5 rounded-full bg-amber-500';
          document.getElementById('handStatusText').innerText = '摄像头已关闭';
          document.getElementById('camBtnText').innerText = '开启手势操控';
          skeletonCtx.clearRect(0, 0, skeletonCanvas.width, skeletonCanvas.height);
        }
      });

      let isDragging = false;
      let previousMousePosition = { x: 0, y: 0 };

      canvas3D.addEventListener('pointerdown', (e) => {
        isDragging = true;
        previousMousePosition = { x: e.clientX, y: e.clientY };
      });

      canvas3D.addEventListener('pointermove', (e) => {
        if (!isDragging) return;

        const deltaMove = {
          x: e.clientX - previousMousePosition.x,
          y: e.clientY - previousMousePosition.y
        };

        relicContainer.rotation.y += deltaMove.x * 0.008;
        relicContainer.rotation.x += deltaMove.y * 0.008;

        previousMousePosition = { x: e.clientX, y: e.clientY };
      });

      window.addEventListener('pointerup', () => { isDragging = false; });

      // Wheel Zoom
      canvas3D.addEventListener('wheel', (e) => {
        e.preventDefault();
        let scale = relicContainer.scale.x - e.deltaY * 0.0015;
        scale = Math.max(0.4, Math.min(2.5, scale));
        relicContainer.scale.set(scale, scale, scale);
      }, { passive: false });

      let clock = new THREE.Clock();

      function animate() {
        requestAnimationFrame(animate);

        const elapsedTime = clock.getElapsedTime();

        // Gentle floating animation
        relicContainer.position.y = Math.sin(elapsedTime * 1.5) * 0.07;
        
        // Auto gentle rotation if idle
        if (!isDragging && !prevHandPos) {
          relicContainer.rotation.y += 0.0025;
        }

        baseRing.rotation.z = elapsedTime * 0.2;
        scanBeam.position.y = Math.sin(elapsedTime * 1.8) * 1.8;

        const positions = particleGeo.attributes.position.array;
        for (let i = 1; i < particleCount * 3; i += 3) {
          positions[i] += 0.012;
          if (positions[i] > 3.6) positions[i] = 0;
        }
        particleGeo.attributes.position.needsUpdate = true;

        renderHotspotPositions();
        renderer.render(scene, camera);
      }

      animate();
    }

    // Launch application safely when DOM and scripts are ready
    window.addEventListener('DOMContentLoaded', () => {
      ensureThreeLoaded(initHologramApp);
    });
  </script>
</body>
</html>
