      // Switch Relic Function
      function switchRelic(index) {
        if (index === currentRelicIdx && relicContainer.children.length > 0) return;
        audioSFX.playSwitch();

        const oldModel = relicModels[currentRelicIdx];
        currentRelicIdx = index;
        const newModel = relicModels[currentRelicIdx];

        relicContainer.remove(oldModel);
        relicContainer.add(newModel);
        relicContainer.scale.set(0.1, 0.1, 0.1);

        let scaleProgress = 0.1;
        const animInt = setInterval(() => {
          scaleProgress += 0.09;
          if (scaleProgress >= 1.0) {
            scaleProgress = 1.0;
            clearInterval(animInt);
          }
          relicContainer.scale.set(scaleProgress, scaleProgress, scaleProgress);
